<Project>
  <!--
    薄い Directory.Build.props (参照型)。ソリューション直下に置く。MSBuild は、最も近い Directory.Build.props を 1 つしか
    読まないので、親のフォルダにあるものも、ここで読む。

    共通の設定は、コピーせずに、外の正本 (msbuild-common) を参照する。場所は、環境変数 MSBUILD_COMMON_DIR
    (Windows 側。Visual Studio とウォッチャーが読む)。設定されていないと、ビルドは、次のエラーで止まる:
      The imported project "__MSBUILD_COMMON_DIR_NOT_SET__\Common.props" was not found
  -->

  <PropertyGroup>
    <_ParentBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_ParentBuildProps>
    <MsbuildCommonDir>$(MSBUILD_COMMON_DIR)</MsbuildCommonDir>
    <MsbuildCommonDir Condition="'$(MsbuildCommonDir)' == ''">__MSBUILD_COMMON_DIR_NOT_SET__</MsbuildCommonDir>
  </PropertyGroup>
  <Import Project="$(_ParentBuildProps)" Condition="'$(_ParentBuildProps)' != ''" />

  <Import Project="$(MsbuildCommonDir)\Common.props" />
</Project>
